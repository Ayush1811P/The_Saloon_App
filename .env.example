VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-side only. Do not put these in VITE_ variables or frontend bundles.
# Configure them as Supabase Edge Function secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only
DISPATCHER_SECRET=generate-a-long-random-secret
DISPATCHER_ALLOWED_ORIGIN=https://your-frontend.example
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=server-side-vapid-public-key
VAPID_PRIVATE_KEY=server-side-vapid-private-key
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=server-side-service-account-email
FIREBASE_PRIVATE_KEY=server-side-service-account-private-key
